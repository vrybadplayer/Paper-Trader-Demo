# Example environment variables for the trading bot
# Copy to .env and fill in the values

# Broker API Keys (for live trading, leave empty for sandbox)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Other services (if needed)
# NEWS_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=

# ChromaDB (if using remote, otherwise leave as default)
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# Logging
LOG_LEVEL=INFO