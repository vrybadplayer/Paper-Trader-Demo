# =====================================================================
# Dual-Agent Paper Trading Bot - Bursa Malaysia (MYX / KLSE) Environment
# Copy this file to .env:  cp config/.env.example .env
# =====================================================================

# --- Moomoo Malaysia / FutuOpenD Gateway for Bursa Malaysia ---
# Download & run FutuOpenD from: https://www.moomoo.com/en-my/download/OpenAPI
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
MOOMOO_USER_ID=
MOOMOO_TRADING_PWD=
MOOMOO_PAPER_SIMULATION=true

# --- Interactive Brokers (IBKR) MYX Gateway (Alternative) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497 # 7497 for TWS Paper, 4002 for IB Gateway Paper
IBKR_CLIENT_ID=1

# --- Local LLM & Ollama Configuration ---
OLLAMA_BASE_URL=http://localhost:11434
WORKER_MODEL=deepseek-r1:14b
CRITIC_MODEL=deepseek-r1:14b

# --- ChromaDB Vector Store ---
CHROMADB_PERSIST_DIR=./database/data/chroma_db

# --- Logging ---
LOG_LEVEL=INFO
